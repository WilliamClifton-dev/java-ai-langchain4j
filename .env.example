# HBTI Coach environment catalog. Never commit real values.

# Runtime profile: offline (deterministic features only), minimax, or local (Ollama).
APP_PROFILE=offline

# Database. Compose uses MYSQL_PASSWORD and supplies its internal URL/user.
MYSQL_URL=jdbc:mysql://localhost:3306/hbti_coach?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Hong_Kong
MYSQL_USERNAME=root
MYSQL_PASSWORD=<replace-with-a-secret>
MYSQL_POOL_SIZE=10

# Redis holds bounded ephemeral/reconstructable state only.
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT=200ms
REDIS_COMMAND_TIMEOUT=200ms

# Authentication and browser origin.
AUTH_SIGNING_KEY=<replace-with-at-least-32-utf8-bytes>
AUTH_SECURE_COOKIES=true
CORS_ALLOWED_ORIGINS=https://coach.example.com
CORS_MAX_AGE=PT1H

# Host ports used by Docker Compose.
BACKEND_PORT=8080
WEB_PORT=5173

# MiniMax profile. Required only when APP_PROFILE=minimax.
MINIMAX_API_KEY=<replace-with-provider-secret>

# Ollama profile. Used only when APP_PROFILE=local.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_NAME=qwen:latest

# Coach stream and circuit controls.
COACH_FIRST_TOKEN_TIMEOUT=PT5S
COACH_TOTAL_TIMEOUT=PT30S
COACH_MAX_CONCURRENT=5
COACH_CIRCUIT_FAILURE_THRESHOLD=3
COACH_CIRCUIT_OPEN_DURATION=PT30S
COACH_MAX_INPUT_TOKENS=8000
COACH_MAX_OUTPUT_TOKENS=1500

# Shared rate controls.
LOGIN_MAXIMUM_FAILURES=10
LOGIN_RATE_WINDOW=PT15M
COACH_MAXIMUM_REQUESTS=20
COACH_RATE_WINDOW=PT1M

# Exact database-retention cleanup policy. Keep enabled in public-beta deployments.
RETENTION_CLEANUP_ENABLED=true
RETENTION_CLEANUP_INITIAL_DELAY=PT1H
RETENTION_CLEANUP_INTERVAL=PT24H
REFRESH_TOKEN_RETENTION_GRACE=P7D
AUDIT_EVENT_RETENTION=P180D

# Structured application log threshold.
LOG_LEVEL_ROOT=INFO

# Opt-in test boundary. Default tests never contact a provider.
RUN_EXTERNAL_TESTS=false

# Local HTTP only. Production must use true behind TLS.
# AUTH_SECURE_COOKIES=false
