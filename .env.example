# HBTI Coach Environment Variables

## Required Variables

### Database
MYSQL_URL=jdbc:mysql://localhost:3306/hbti_coach?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Hong_Kong
MYSQL_USERNAME=root
MYSQL_PASSWORD=<your-mysql-password>

### Redis
REDIS_URL=redis://localhost:6379

### Authentication
AUTH_SIGNING_KEY=<your-jwt-signing-key-min-32-bytes>
AUTH_SECURE_COOKIES=true

### AI Model (choose one profile)
MINIMAX_API_KEY=<your-minimax-api-key>
# or for local Ollama:
# APP_PROFILE=local
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL_NAME=qwen:latest

## Optional Variables

### Server
SERVER_PORT=8080

### Database Pool
MYSQL_POOL_SIZE=10

### Redis Timeouts
REDIS_CONNECT_TIMEOUT=200ms
REDIS_COMMAND_TIMEOUT=200ms

### Coach Streaming
COACH_FIRST_TOKEN_TIMEOUT=PT5S
COACH_TOTAL_TIMEOUT=PT30S
COACH_CONCURRENCY_LIMIT=5

### Rate Limiting
HBTI_RATE_LOGIN_MAXIMUM_FAILURES=10
HBTI_RATE_LOGIN_WINDOW=PT15M

## Development Only (DO NOT USE IN PRODUCTION)

### Test External Model
RUN_EXTERNAL_TESTS=false

### Local HTTP (disables secure cookies)
AUTH_SECURE_COOKIES=false
